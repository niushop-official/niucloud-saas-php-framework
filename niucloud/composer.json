{
    "name": "topthink/think",
    "description": "the new thinkphp framework",
    "type": "project",
    "keywords": [
        "framework",
        "thinkphp",
        "ORM"
    ],
    "homepage": "https://www.thinkphp.cn/",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "liu21st",
            "email": "liu21st@gmail.com"
        },
        {
            "name": "yunwuxin",
            "email": "448901948@qq.com"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "topthink/framework": "v8.1.4",
        "topthink/think-orm": "v4.0.51",
        "topthink/think-filesystem": "v3.0.0",
        "topthink/think-template": "v3.0.2",
        "topthink/think-view": "v2.0.5",
        "topthink/think-captcha": "v3.0.11",
        "topthink/think-image": "v1.0.8",
        "firebase/php-jwt": "v5.5.1",
        "spatie/macroable": "v1.0.1",
        "dh2y/think-qrcode": "v2.0",
        "dragonmantank/cron-expression": "^3.6.0",
        "phpoffice/phpspreadsheet": "v1.28.0",
        "qiniu/php-sdk": "^7.14.0",
        "qcloud/cos-sdk-v5": "^2.6.17",
        "aliyuncs/oss-sdk-php": "v2.6.0",
        "alibabacloud/client": "v1.5.32",
        "rmccue/requests": "^2.0.20",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-bcmath": "*",
        "ext-mbstring": "*",
        "php-di/php-di": "^7.1.1",
        "guzzlehttp/guzzle": "^7.15.5",
        "symfony/psr-http-message-bridge": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/cache": "^6.4",
        "symfony/http-client": "^6.4",
        "symfony/mime": "^6.4",
        "symfony/var-exporter": "^7.4",
        "laravel/serializable-closure": "^1.3",
        "fastknife/ajcaptcha": "v1.2.2",
        "kosinix/grafika": "dev-master",
        "nesbot/carbon": "^2.73.0",
        "ext-zip": "*",
        "mjaschen/phpgeo": "4.2.0",
        "tencentcloud/sms": "^3.0",
        "w7corp/easywechat": "^6.20.0",
        "workerman/workerman": "^4.2.1",
        "workerman/redis-queue": "^1.2.2",
        "workerman/crontab": "^1.0.7",
        "hyperf/pimple": "~2.2.0",
        "365taofang/huaweicloud-sdk-php-obs": "^3.23",
        "kkokk/poster": "^2.3",
        "ezyang/htmlpurifier": "v4.19.0",
        "topthink/think-multi-app": "^1.1",
        "yansongda/pay": "^3.7",
        "workerman/gateway-worker": "3.1",
        "workerman/gatewayclient": "3.1"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4.45",
        "topthink/think-trace": "v2.0"
    },
    "autoload": {
        "psr-4": {
            "addon\\": "addon",
            "app\\": "app",
            "core\\": "core"
        },
        "psr-0": {}
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "easywechat-composer/easywechat-composer": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    },
    "repositories": {
        "packagist": {
            "type": "composer",
            "url": "https://mirrors.tencent.com/composer"
        }
    }
}