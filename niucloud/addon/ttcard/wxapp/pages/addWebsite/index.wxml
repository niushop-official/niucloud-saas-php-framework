<view wx:if="{{loginStatus}}">
  <view style="padding-bottom:80rpx">
 
    <cu-custom isBack='{{true}}' bgColor="bg-white"><view slot="content" class="text-bold text-black text-lgbg-white">{{sub.subtype == 'editWebsite' ? '编辑微官网' : '创建微官网'}}</view></cu-custom>

    <view class="flex margin-lr margin-top-lg shadow-gray-light column margin-top radius-30 bg-white hidden padding-tb-sm">
      <view class="cu-form-group margin-lr text-lg">
        <view class="title flex text-black">企业名称<text class="text-red margin-left-xs margin-top-xs">*</text></view>
        <input placeholder="请输入企业名称" bindinput='nameInput' value='{{sub.name}}' maxlength="30" class="text-black"></input>
      </view>
      <view class="cu-form-group margin-lr text-lg">
        <view class="title flex text-black">企业电话<text class="text-red margin-left-xs m-t">*</text></view>
        <input placeholder="请输入手机号" value='{{sub.phone}}' bindinput='phoneInput' class="text-black"></input>
      </view>

      <view class="cu-form-group padding-top margin-lr text-lg ">
        <view class="title flex text-black">行业分类<text class="text-red margin-left-xs m-t">*</text></view>
        <picker bindchange="industryChange" class="text-left" value="{{industryIndex}}" range="{{industry}}">
          <view class="picker ">
            <text class="text-black text-lg" wx:if="{{industryIndex || industryIndex == 0}}">{{industry[industryIndex]}}</text>
            <text class="text-lg"  wx:else>请选择行业分类</text>
          </view>
        </picker>
      </view>
      <view class="cu-form-group padding-top margin-lr text-lg relative">
        <view class="flex align-center" bind:tap='goCardholder' >
          <view class="title flex text-black">绑定名片</view>
          <input placeholder="请绑定名片" disabled value='{{cardName}}' class="text-black"></input>
        </view> 
        <view class='cuIcon-questionfill tipsBox margin-left text-gray' bind:tap="showTips" data-type="mp"></view>
      </view> 
      <view class="cu-form-group margin-lr text-lg">
        <view class="title flex text-black">企业地址</view>
        <input placeholder="请输入企业地址" bindinput='addressInput' value='{{sub.address}}' class="text-black"></input>
      </view> 
    </view>


    <view class="flex margin-lr shadow-gray-light column margin-top radius-30 bg-white hidden">
      <view class="cu-form-group align-center margin-left">
        <view class="title flex flex-1 justify-between text-black">
          <view>企业简介<text class="text-red margin-left-xs margin-top-xs">*</text></view>
          <view class="text-gray">{{textLength}}/2000</view>
        </view>
      </view>
      <view class="margin-lr padding-bottom">
        <view class="container" style="height:{{editorHeight}}px;">
          <editor id="editor" class="ql-container" placeholder="{{placeholder}}" bindinput="editorContentChange" bindready="onEditorReady">
          </editor>
        </view>

      </view>
    </view>


    <view class="flex margin-lr shadow-gray-light column margin-top radius-30 bg-white hidden padding-tb-sm">
      <view class="cu-form-group margin-lr text-lg">
        <view class="title flex text-black">企业微信</view>
        <input placeholder="请输入企业微信号" bindinput='wechat_numInput' value='{{sub.wechat_num}}' class="text-black"></input>
      </view>
      <view class="cu-bar bg-white solid-top margin-lr" style="min-height: 120rpx;">
        <view class="action text-black flex" style="margin-left:0;font-size:32rpx">
          企业微信二维码
        </view>
        <view class="action text-gray">
          {{weixin_image.length}}/1
        </view>
      </view>
      <view class="cu-form-group margin-lr" style="padding:0 0 20rpx 0">
        <view class="grid col-4 grid-square flex-sub">
          <view class="bg-img" wx:for="{{weixin_image}}" wx:key="index" bindtap="ViewImage" data-url="{{weixin_image[index]}}">
            <image src='{{weixin_image[index]}}' mode='aspectFill'></image>
            <view class="cu-tag bg-red" catchtap="DelImg_wx" data-type='weixin' data-index="{{index}}">
              <text class="cuIcon-close"></text>
            </view>
          </view>
          <view class="solids" bind:tap="updateLoadImg" data-imgs='1' data-type='weixin' wx:if="{{weixin_image.length<1}}">
            <text class="cuIcon-cameraadd"></text>
          </view>
        </view>
      </view>
    </view>




    <view class="flex margin-lr  padding-tb-sm shadow-gray-light column margin-top radius-30 bg-white hidden relative"> 
      <view class="cu-bar bg-white margin-lr">
        <view class="action text-black flex" style="margin-left:0;font-size:32rpx">
          企业视频
        </view>
      </view>
      <view class="cu-form-group margin-lr relative" style="padding:0 0 10rpx 0">
        <view class="relative radius-12 hidden" wx:if="{{sub.video}}">
          <video src="{{sub.video}}" binderror="videoErrorCallback" show-center-play-btn='{{false}}' show-play-btn="{{true}}" controls></video>
          <view class="absolute padding-xs right-0 top-0 z-9999">
            <text class="cuIcon-close text-white" bindtap="delVideo"></text>
          </view>
        </view>
        <view class="bg-gray flex align-center justify-center videoBox opacity-06" bindtap="updateLoadImg" data-type='video' wx:if="{{!sub.video}}">
          <text class="cuIcon-cameraadd text-grey"></text>
        </view>
      </view>
    </view>


    <view class="flex margin-lr  padding-tb-sm shadow-gray-light column margin-top radius-30 bg-white hidden">
      <view class="cu-bar bg-white margin-lr">
        <view class="action text-black flex" style="margin-left:0;font-size:32rpx">
          企业LOGO<text class="text-red margin-left-xs margin-top-xs">*</text>
        </view>
        <view class="action text-gray" style="margin-right:0;">
          {{logo.length}}/1
        </view>
      </view>
      <view class="cu-form-group margin-lr" style="padding:0 0 10rpx 0">
        <view class="grid col-4 grid-square flex-sub">
          <view class="bg-img" wx:for="{{logo}}" wx:key="index" data-url="{{logo[index]}}">
            <image src='{{logo[index]}}' mode='aspectFill'></image>
            <view class="cu-tag bg-red" catchtap="DelImg_1" data-index="{{index}}">
              <text class="cuIcon-close"></text>
            </view>
          </view>
          <view class="solids" bindtap="updateLoadImg" data-type='logo' wx:if="{{logo.length<1}}">
            <text class="cuIcon-cameraadd"></text>
          </view>
        </view>
      </view>
    </view>


    <view class="flex margin-lr  padding-tb-sm shadow-gray-light column margin-top radius-30 bg-white hidden">
      <view class="cu-bar bg-white margin-lr">
        <view class="action text-black flex" style="margin-left:0;font-size:32rpx">
          企业图片<text class="text-red margin-left-xs margin-top-xs">*</text>
        </view>
        <view class="action text-gray">
          {{imgList.length}}/20
        </view>
      </view>
      <view class="cu-form-group margin-lr" style="padding:0 0 10rpx 0">
        <view class="grid col-4 grid-square flex-sub">
          <view class="bg-img" wx:for="{{imgList}}" wx:key="index" bindtap="ViewImage" data-url="{{imgList[index]}}">
            <image src='{{imgList[index]}}' mode='aspectFill'></image>
            <view class="cu-tag bg-red" catchtap="DelImg" data-index="{{index}}">
              <text class="cuIcon-close"></text>
            </view>
          </view>
          <view class="solids" bindtap="updateLoadImg" data-imgs='20' data-type='images' wx:if="{{imgList.length<20}}">
            <text class="cuIcon-cameraadd"></text>
          </view>
        </view>
      </view>
    </view>

    <view class="flex margin-lr  padding-tb-sm shadow-gray-light column margin-top radius-30 bg-white hidden">
      <view class="cu-bar bg-white margin-lr">
        <view class="action text-black flex" style="margin-left:0;font-size:32rpx">
          顶部轮播
        </view>
        <view class="action text-gray" style="margin-right:0;">
          {{swiper.length}}/4
        </view>
      </view>
      <view class="cu-form-group margin-lr" style="padding:0 0 10rpx 0">
        <view class="grid col-4 grid-square flex-sub">
          <view class="bg-img" wx:for="{{swiper}}" wx:key="index" bindtap="ViewImage_swiper" data-url="{{swiper[index]}}">
            <image src='{{swiper[index]}}' mode='aspectFill'></image>
            <view class="cu-tag bg-red" catchtap="DelImg_swiper" data-index="{{index}}">
              <text class="cuIcon-close"></text>
            </view>
          </view>
          <view class="solids" bindtap="updateLoadImg"  data-imgs='4'  data-type='swiper' wx:if="{{swiper.length<4}}">
            <text class="cuIcon-cameraadd"></text>
          </view>
        </view>
      </view>
    </view>

    <view class="breathing-element padding-tb text-lg text-bold text-center bg-gradual-orange  round lg margin-top-xl shadow-gray padding-lr margin-lr" style="box-shadow: 0 10px 30px 0 rgba(255,134,53,.47);" bind:tap="checkUserExpirationTime">{{sub.subtype == 'editWebsite' ? '提交修改' : '创建微官网'}}</view>

  </view>
</view>