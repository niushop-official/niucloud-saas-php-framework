<view>
<view style="padding-bottom:80rpx">
  <cu-custom bgColor="bg-white" isBack="{{true}}">
    <view slot="content" class="text-lg text-bold text-black">{{sub.subtype == 'editNews' ? '编辑资讯' : '添加资讯'}}</view>
  </cu-custom>
  

  <view class="flex margin-lr shadow-gray-light column margin-top-lg radius-30 bg-white hidden padding-tb-sm" style="margin-top:{{CustomBar+20}}px;"> 
      <view class="cu-form-group padding-top margin-lr text-lg relative">
        <view class="flex align-center" bind:tap='goCardholder' >
          <view class="title flex text-black">绑定名片</view>
          <input placeholder="请绑定名片" disabled value='{{cardName}}' class="text-black"></input>
        </view> 
        <view class='cuIcon-questionfill tipsBox margin-left text-gray' bind:tap="showTips" data-type="mp"></view>
      </view> 
      <view class="cu-form-group padding-top margin-lr text-lg relative">
        <view class="flex align-center" bind:tap='goWebsiteList' >
          <view class="title flex text-black">绑定微官网</view>
          <input placeholder="请绑定微官网" disabled value='{{websiteName}}' class="text-black"></input>
        </view>
        <view class='cuIcon-questionfill tipsBox margin-left text-gray' bind:tap="showTips" data-type="wgw"></view>
      </view>    
    <view class="cu-form-group margin-lr text-lg">
      <view class="title flex text-black">标题<text class="text-red margin-left-xs margin-top-xs">*</text></view>
      <input placeholder="请输入标题" bindinput='titleInput' value='{{sub.title}}'  maxlength="60"  class="text-black"></input>
    </view> 
  </view> 

  <view class="flex margin-lr shadow-gray-light column margin-top radius-30 bg-white hidden">
      <view class="cu-bar bg-white margin-lr" style="min-height: 120rpx;">
      <view class="action text-black flex" style="margin-left:0;font-size:32rpx">
        缩略图<text class="text-red margin-left-xs margin-top-xs">*</text>
      </view>
      <view class="action text-gray">
        {{imgList.length}}/1
      </view>
    </view>
    <view class="cu-form-group margin-lr" style="padding:0 0 10rpx 0">
      <view class="grid col-4 grid-square flex-sub">
        <view class="bg-img" wx:for="{{imgList}}" wx:key="index" bindtap="ViewImage" data-url="{{imgList[index]}}">
          <image src='{{imgList[index]}}' mode='aspectFill'></image>
          <view class="cu-tag bg-red" catchtap="DelImg" data-index="{{index}}">
            <text class="cuIcon-close"></text>
          </view>
        </view>
        <view class="solids" bindtap="updateLoadImg" data-type='image'  data-imgs='1' wx:if="{{imgList.length<1}}">
          <text class="cuIcon-cameraadd"></text>
        </view>
      </view>
    </view>
    </view>

  <view class="flex margin-lr shadow-gray-light column margin-top radius-30 bg-white hidden">
    <view class="cu-form-group align-center margin-left">
      <view class="title flex flex-1 justify-between text-black">
        <view>内容<text class="text-red margin-left-xs margin-top-xs">*</text></view>
        <view class="text-gray">{{textLength}}/2000</view>
      </view>
    </view>
    <view class="margin-lr padding-bottom"> 
      <view class="container" style="height:{{editorHeight}}px;">
        <editor id="editor" class="ql-container" placeholder="{{placeholder}}" bindinput="editorContentChange" bindready="onEditorReady">
        </editor>
      </view> 
    </view>
  </view>
 
<view class="breathing-element padding-tb text-lg text-bold text-center bg-gradual-orange  round lg margin-top-xl shadow-gray padding-lr margin-lr" style="box-shadow: 0 10px 30px 0 rgba(255,134,53,.47);"bind:tap="checkUserExpirationTime" >{{sub.subtype == 'editNews' ? '提交修改' : '添加'}}</view> 
</view>
</view>