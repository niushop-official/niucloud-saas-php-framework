/* pages/websiteList/index.wxss */

.cu-avatar {
  width: 180rpx;
    height: 180rpx;
    min-width: 180rpx;
}
 



.HyBox{
  transition: .3s;
  min-height:400rpx;
  max-height:1000rpx;
  z-index: 99;
  bottom:-800px;
  border-top-left-radius:30rpx; 
  border-top-right-radius:30rpx; 
  border-bottom-left-radius:0; 
  border-bottom-right-radius:0; 
  overflow: hidden;
}
.HyBox scroll-view{
  height:800rpx;
}
.showHyBox{
  bottom:0!important;
  transition: .3s;
}
.HyBoxModel{
  background-color: rgba(0,0,0,.5);
  position: fixed;
  bottom:0;
  left: 0;
  width: 100%;
  height:100vh;
  transition: .5s; 
  z-index: 0;
}
