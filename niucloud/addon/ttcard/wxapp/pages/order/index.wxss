/* pages/order/index.wxss */


.HyBox{
  transition: .3s;
  height:1000rpx;
  z-index: 99999;
  bottom:-800px;
  border-top-left-radius:30rpx; 
  border-top-right-radius:30rpx; 
  overflow: hidden;
}
.HyBox scroll-view{
  height:800rpx;
}
.showHyBox{
  bottom:0!important;
  transition: .3s;
}
.HyBoxModel{
  background-color: rgba(0,0,0,.5);
  position: fixed;
  bottom:0;
  left: 0;
  width: 100%;
  height:100vh;
  transition: .5s; 
  z-index: 9999;
}

.step{
  width:60rpx;
  height:60rpx;
  font-size:40rpx;
}
.step_num{
  width:100rpx;
  height:60rpx;
}
