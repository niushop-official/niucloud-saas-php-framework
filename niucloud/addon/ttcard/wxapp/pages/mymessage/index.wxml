<scroll-view  scroll-y class="scrollPage"	bindscrolltolower='isonReachBottom'>
<view style="padding-bottom:80rpx">
  <cu-custom bgColor="bg-white" isBack="{{true}}">
    <view slot="content" class="text-lg text-bold text-black">我的消息</view>
  </cu-custom>

  <view class="cu-bar bg-white search fixed" style="top:{{CustomBar}}px;">
  <scroll-view scroll-x class="bg-white nav">
    <view class="flex text-center">
      <view class="cu-item flex-sub {{index==TabCur?'text-orange cur':''}}" wx:for="{{nav}}" wx:key='index' bindtap="tabSelect" data-index="{{index}}">
        {{item}}
      </view>
    </view>
  </scroll-view>
</view>



  <view class="flex margin-top-lg column margin-lr"style="margin-top:calc({{CustomBar+10}}px )" >
    <view class="flex column padding padding-tb-lg shadow-gray-light  margin-bottom radius-24 bg-white hidden"  wx:for="{{list}}" wx:key="index" bind:tap="goMessageDetail" data-id="{{item.id}}">
      <view class="flex justify-between ">
        <view class="hidden flex justify-center   column">
        <view class="text-black text-lg flex align-center overflow-hidden" >
          <text class="text-cut-1">{{item.title}} </text>  
        </view> 
 
        <view class=" margin-top-sm">
          <view class="text-sm" wx:if="{{item.type_status == 'systemmessages'}}">
            <text class="text-gray cuIcon-tag " wx:if="{{TabCur ==0}}"></text> 
            <text class="text-gray margin-left-xs  margin-right" wx:if="{{TabCur ==0}}">系统消息</text>
            <text class="text-gray cuIcon-time"></text> 
            <text class="text-gray  margin-left-xs">{{item.createtime}}</text>
          </view>
          <view class="text-sm " wx:if="{{item.type_status == 'leavemessage'}}">
            <text class="text-orange cuIcon-tag " wx:if="{{TabCur ==0}}"></text> 
            <text class="text-orange margin-left-xs  margin-right" wx:if="{{TabCur ==0}}">用户留言</text>
            <text class="text-gray cuIcon-time"></text> 
            <text class="text-gray  margin-left-xs">{{item.createtime}}</text>
          </view>
        </view>
      </view>
      <view class="flex align-center">
        <text class="cuIcon-right text-gray margin-left"></text>
      </view>
      </view> 
    </view>
  </view>


  <view class="emptyBox" wx:if="{{list.length == 0}}">
    <image src="../../images/empty.png" />
    <view class="text text-gray">~ 暂无相关内容 ~</view>
  </view>


</view>
</scroll-view>