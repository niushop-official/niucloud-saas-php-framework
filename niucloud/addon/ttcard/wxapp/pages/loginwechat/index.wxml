<cu-custom bgColor="" isBack="{{true}}">
  <view slot="content" class="text-lg text-bold text-black"></view>
</cu-custom>  
<view class="fixed  top-0 left-0 w--100 h--100 flex align-center">
  <view class="margin-lr-lg flex-1 ">
    <view class="column justify-center flex" style="margin-top:-280rpx;margin-bottom:200rpx"> 
      <view class="text-xxl flex justify-center text-bold margin-top-sm">登录 / 注册</view>
      <view class="margin-top-xs flex justify-center text-xxl text-orange opacity-06">——</view>
      <view class="text-gray flex justify-center margin-top-xs">~ 欢迎使用名片生成系统 ~</view>
    </view>
    <view class="padding-tb margin-top-xl breathing-element text-xl text-bold text-center bg-gradual-orange round lg shadow-orange align-center relative ">
      手机号快捷登录
      <button class="absolute w--100 h--100 top-0" style="padding:0;opacity:0" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber"></button>
    </view> 

  </view>
</view>
 
<view class="fixed flex align-center w--100 padding-bottom-xl column bottom-0" wx:if="{{accountLogin_switch == 1 || dxbLogin_switch == 1}}">
  <view class="text-gray">- 其他登录方式 -</view>
  <view class="flex jsutify-center">
    <navigator url="/pages/loginmobile/index" hover-class="none" class="padding-tb text-xxl text-center bg-gradual-orange margin-lr-sm margin-tb mobileBox round shadow-orange align-center" wx:if="{{dxbLogin_switch == 1}}"><view style="margin-top: -6rpx;"><text class="cuIcon-mobile"></text></view></navigator>
    <navigator url="/pages/loginaccount/index" hover-class="none" class="padding-tb text-xxl margin-lr-sm text-center bg-gradual-orange margin-tb mobileBox round shadow-orange align-center"  wx:if="{{accountLogin_switch == 1}}"><view style="margin-top: -6rpx;"><text class="cuIcon-command"></text></view></navigator>
  </view>
</view>
    
<view class="vipBox_1 a1"></view>
