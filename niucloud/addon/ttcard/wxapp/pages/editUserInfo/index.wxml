<scroll-view scroll-y class="scrollPage">
<view style="padding-bottom:80rpx">
  <cu-custom bgColor="bg-white" isBack="{{true}}">
    <view slot="content" class="text-lg text-bold text-black">编辑用户信息</view>
  </cu-custom>

  <view class="flex margin-lr shadow-gray-light column margin-top-lg radius-24 bg-white hidden padding-top padding-bottom-sm">
    <view class="flex justify-between align-center margin-top padding-lr">
      <view class="flex column">
        <view class="flex text-black text-lg">头像<text class="text-red margin-left-xs m-t">*</text></view> 
      </view>
      <button class="avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" style="background: none;border:none">
        <view class="cu-avatar xl round"  wx:if="{{avatar}}" style="background-image:url({{avatar}});"></view> 
        <view class="cu-avatar xl round" wx:if="{{!avatar}}"><text class="cuIcon-my"></text></view>
      </button>
 
    </view> 
    <view class="cu-form-group margin-top padding-top margin-lr text-lg solid-top">
      <view class="title flex text-black">昵称<text class="text-red margin-left-xs m-t">*</text></view>
      <input type="text" confirm-type='send' bindinput='nicknameChange' placeholder="请输入昵称" value='{{nickname}}' class="text-black text-right"></input> 
    </view> 
  </view>
  <view class="flex margin-lr shadow-gray-light column margin-top radius-24 bg-white hidden" bind:tap="updateUserInfo">
    <view class="text-lg align-center padding-tb text-bold flex justify-center text-black">提交</view>
  </view>
  <view class="flex margin-lr shadow-gray-light column margin-top-lg radius-24 bg-white hidden" bind:tap="exit">
    <view class="text-lg align-center padding-tb text-bold flex justify-center text-black"><text class="cuIcon-exit margin-right-xs"></text> 退出</view>
</view>


 

</view>
</scroll-view>