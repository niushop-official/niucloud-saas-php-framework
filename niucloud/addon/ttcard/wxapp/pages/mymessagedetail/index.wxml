<scroll-view  scroll-y class="scrollPage"	>
<view style="padding-bottom:80rpx">
  <cu-custom bgColor="bg-white" isBack="{{true}}">
    <view slot="content" class="text-lg text-bold text-black">{{pageTitle}}</view>
  </cu-custom>


  <view class="flex margin-top-lg column margin-lr">
    <view class="flex column padding padding-tb-lg shadow-gray-light  margin-bottom radius-24 bg-white ">
      <view class="text-black text-lg flex  column" >
      <text class="text-cut-1 text-bold text-xl  text-black">{{detail.title}}</text> 
      <view class="margin-top-sm text-gray  text-sm flex align-center">
        <text class="text-gray cuIcon-tag  text-sm "></text>
        <text class="text-gray margin-left-xs margin-right">{{detail.type_status == 'systemmessages' ?'系统消息':'用户留言'}}</text>
            <text class="text-gray  text-sm  cuIcon-time"></text> 
            <text class="text-gray   text-sm margin-left-xs">{{detail.createtime}}</text>
      </view>
      <view class="margin-top ">
        <rich-text style="line-height: 60rpx;" nodes="{{detail.content}}"/>
      </view>
      <view class="solid-top flex justify-between align-center padding-top margin-top-xl" bind:tap="goSubmitMsg" data-id='{{detail.id}}'  data-cardid='{{detail.card_id}}' data-touserid='{{detail.to_user_id}}' data-formuserid='{{detail.form_user_id}}' wx:if="{{TabCur == 0 && detail.type_status != 'systemmessages'}}"> 
        <text>回复消息</text>
        <text class="cuIcon-right text-gray "></text> 
      </view> 
      </view> 
    </view>

    <view class="flex column padding padding-tb-lg shadow-gray-light  margin-bottom radius-24 bg-white " wx:if="{{TabCur == 1 && detail.reply}}">
      <view class="text-bold text-lg text-black"><text class="cuIcon-titles lg text-orange kk-p margin-right-xs"></text>我收到的回复</view> 
      <view class="text-black text-lg flex margin-top solid-top padding-top column" >
      <text class="text-cut-1 text-bold text-xl  text-black">{{detail.reply.title}}</text> 
      <view class="margin-top-sm text-gray flex align-center">
        <text class="cuIcon-time"></text> 
        <text class="margin-left-xs">{{detail.reply.createtime}}</text>
      </view>
      <view class="margin-top ">
        <rich-text style="line-height: 60rpx;" nodes="{{detail.reply.content}}"/>
      </view>
      <view class="solid-top flex justify-between align-center padding-top margin-top-xl" bind:tap="goSubmitMsg"  data-id='{{detail.id}}'  data-cardid='{{detail.card_id}}' data-touserid='{{detail.to_user_id}}' data-formuserid='{{detail.form_user_id}}'>
        <text>继续发送消息</text>
        <text class="cuIcon-right text-gray "></text>
      </view> 
      </view> 
    </view>
 
  </view>
 

</view>
</scroll-view>